{
  // Vitest program: type-checks src + tests together without emitting. The
  // browser UI entry and its component carry the client-runtime merges,
  // which must not meet the host Context merges in one program; they are
  // type-checked by the client project instead (tests never import them).
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "src/client/index.ts",
    "src/client/SubagentRolesSection.tsx"
  ]
}
